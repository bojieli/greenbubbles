.DS_Store
/.build
/.swiftpm
/Native/GreenBubbles/target
*.xcuserstate
DerivedData/

# Never commit user data, database snapshots, credentials, or extracted material.
/captures
/fixtures/private
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.key
*.pem
*.p12
*.mobileprovision

# Local tool test area; may contain extracted key material (e.g. all_keys.json).
/.tmp

# Extracted key/passphrase artifacts and decrypted database output must never
# enter the repository. Enforced by scripts/check-secret-hygiene.swift.
all_keys.json
wechat-passphrase.json
*-passphrase.json
decrypted/

# Send-adapter release signing seeds. The verifying (public) key is pinned into
# builds; the seed stays on the release machine and never enters the repository.
*signing-key*.json
*signing-seed*.json

# Python bytecode from the packaging checks.
__pycache__/

# Local agent scratch space, including agent worktrees checked out in place.
# Ignored, and therefore outside the secret-hygiene scan, like /.tmp above.
/.claude
