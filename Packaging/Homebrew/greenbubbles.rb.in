# Generated by scripts/homebrew-release.py from a published CLI archive.
class Greenbubbles < Formula
  desc "Read your own WeChat history locally and provide bounded context to agents"
  homepage "https://github.com/@REPOSITORY@"
  url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/greenbubbles-@VERSION@-macos-arm64.zip"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "MIT"

  depends_on arch: :arm64
  depends_on macos: :sonoma

  # Preserve upstream Developer ID signatures on the notarized executables.
  skip_clean "libexec"

  def install
    libexec.install Dir["*"]
    bin.install_symlink (libexec/"bin").children
  end

  def caveats
    <<~EOS
      This installs the signed Apple-silicon CLI/tool set, not the native app.
      Documentation and skills shipped in this release are under:
        #{opt_libexec}
      Point your coding agent at a SKILL.md there; skill installation is optional.
      Source/profile setup and owner-operated key capture are separate steps.
    EOS
  end

  test do
    assert_match "Usage", shell_output("#{bin}/greenbubbles --help")
    assert_match "memory", shell_output("#{bin}/greenbubbles memory --help")
  end
end
