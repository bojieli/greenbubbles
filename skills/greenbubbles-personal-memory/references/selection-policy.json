  "directContextBefore": 24,
  "directContextAfter": 24,
  "groupContextBefore": 12,
  "groupContextAfter": 16,
  "maximumMessageTextBytes": 4096,
  "maximumUnitMessages": 160,
  "maximumUnitTextBytes": 49152,
  "deliveryOrder": "accountHolderRelevance",
